 }
+
+/* Insurance section only: approved blue/cyan palette, 15 October 2026. */
+#insurance.insurance-section {
+  --lime-500: #42cfff;
+  background:
+    radial-gradient(circle at 88% 5%, rgba(66,207,255,.14), transparent 26%),
