+    var(--navy-950);
+}
+#insurance .insurance-cta {
+  color:#fff;
+  background:linear-gradient(135deg,#1266d9,#1052a3);
+  border-color:#42cfff;
+  box-shadow:0 0 22px rgba(66,207,255,.3),0 5px 0 #073a76;
+}
+#insurance .insurance-cta:hover {
+  background:linear-gradient(135deg,#1a7cce,#1266d9);
+  box-shadow:0 0 30px rgba(66,207,255,.45),0 5px 0 #073a76;
+}
+#insurance .insurance-cta:focus-visible {outline:2px solid #42cfff;outline-offset:5px;}
+#insurance .insurance-process-panel,
+#insurance .insurance-service-card,
+#insurance .insurance-company-showcase {
+  border-color:rgba(66,207,255,.5);
+  box-shadow:0 0 0 1px rgba(66,207,255,.1),0 0 26px rgba(66,207,255,.18);
+}
+#insurance .insurance-company-showcase {background:rgba(18,102,217,.065);}
